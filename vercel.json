{
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/studio" },
    { "source": "/api-docs", "destination": "/docs/API.md" },
    { "source": "/onboarding", "destination": "/ONBOARDING.md" }
  ],
  "redirects": [
    { "source": "/workbench", "destination": "/studio", "permanent": true },
    { "source": "/workbench.html", "destination": "/studio", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api-docs",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/onboarding",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
