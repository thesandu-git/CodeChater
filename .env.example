# Supabase project settings. Use the server-side service role only in Vercel secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Use long, unique random values. Never reuse one value for another agent.
GROKBOT_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET
CODEX_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET
DEV2_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET
# 工作台上报用；不设就只影响对应的 bot（它会上报 401）
HERMES_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET
OPENBOT_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET
CONSOLE_OWNER_ID=YOUR_SUPABASE_AUTH_USER_UUID
