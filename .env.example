# Supabase project settings. Use the server-side service role only in Vercel secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 引导令牌：只用于 POST /api/studio/agents 登记新 bot，≥16 位随机串。
# 新 bot 登记完拿自己的 wbt_ 令牌，不需要再往这里加变量。
REGISTRY_TOKEN=REPLACE_WITH_RANDOM_SECRET_16_PLUS

# 可选：环境变量形式的 bot 令牌（给老部署留的兼容路径）。
# 留空等于没有——空字符串永远不会匹配任何请求。
GROKBOT_BRIDGE_TOKEN=
CODEX_BRIDGE_TOKEN=
DEV2_BRIDGE_TOKEN=
HERMES_BRIDGE_TOKEN=
OPENBOT_BRIDGE_TOKEN=
