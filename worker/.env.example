# URL of the deployed Vercel console, no trailing slash.
BRIDGE_BASE_URL=https://YOUR_CONSOLE.vercel.app
CODEX_BRIDGE_TOKEN=REPLACE_WITH_THE_CODEX_BRIDGE_TOKEN_FROM_VERCEL

# Existing local checkout of the project that Codex should work on.
CODEX_PROJECT_DIR=C:\\path\\to\\your\\LANKAmate
CODEX_WORKTREE_ROOT=C:\\path\\outside\\the\\project\\agent-worktrees

# Optional; defaults to "codex" resolved from PATH.
CODEX_COMMAND=codex
POLL_INTERVAL_MS=8000
TASK_TIMEOUT_MS=1200000
